# ============================================================================
# Project Atlas — environment configuration
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored and
# must never be committed. Every variable here is validated at process start by
# `src/shared/config/env.ts`; a missing or malformed value fails the boot loudly
# rather than surfacing as a confusing runtime error later.
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------

# Your project's REST URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (formerly "anon"). Safe to expose to the browser: it carries
# no privileges of its own and is always constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (formerly "service_role"). BYPASSES Row Level Security entirely.
# Server-only. Never prefix with NEXT_PUBLIC_, never import into a Client
# Component, never log it. Optional in Sprint 1 — only required by privileged
# background jobs. See src/infrastructure/supabase/admin-client.ts.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Canonical origin, used for auth redirect callbacks and absolute URLs.
# Local: http://localhost:3000 — Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
